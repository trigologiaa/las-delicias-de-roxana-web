{
  "name": "las-delicias-de-roxana-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "arch:check": "depcruise src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:acceptance": "vitest run --project acceptance",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "api:generate": "openapi-typescript openapi.json --output src/lib/api/generated/schema.ts",
    "api:check": "pnpm api:generate --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.82.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.9.0",
    "msw": "^3.0.8",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.18.0"
}
